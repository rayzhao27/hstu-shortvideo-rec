# ── Data dumps ────────────────────────────────────────────────────────────
# Downloaded KuaiRand releases and everything Stage 1 derives from them.
datasets/
*.tar.gz
*.tgz
*.zip

# ── Third-party source ────────────────────────────────────────────────────
# Meta's generative-recommenders, cloned on demand by utils/meta_repo.py.
third_party/

# ── Training outputs (belong on Drive, not in git) ────────────────────────
# runs/ holds checkpoints, TensorBoard events, metrics.jsonl, curves.png.
# The local smoke test writes runs/smoke/.
runs/
checkpoints/
*.pt
*.ckpt
lightning_logs/
tb/
events.out.tfevents.*

# ── Generated data files, wherever they land ──────────────────────────────
# Belt and braces: keeps a stray dump outside datasets/ from being committed.
*.pkl
*.parquet
*.csv
*.npy
*.npz

# ── Figures (regenerated by the scripts) ──────────────────────────────────
pictures/

# ── Notes and drafts, not part of the repo ────────────────────────────────
docs/
README.md
# Generator for colab/hstu_train_colab.ipynb. The notebook is the artifact;
# shipping both would give it two sources of truth.
colab/_build_train_notebook.py

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.so
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# ── Environments ──────────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Editors / OS ──────────────────────────────────────────────────────────
.idea/
.vscode/
.DS_Store
